{
  "name": "dsh-trip-planner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./lib/index.js" },
    "./types": { "types": "./src/types.ts", "default": "./lib/types.js" },
    "./client": { "types": "./src/client/index.tsx", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "external": ["@deepseek-ai/dsh-api-gateway/client"],
      "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
