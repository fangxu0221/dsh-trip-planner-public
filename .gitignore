# 默认忽略根目录新增内容，只开放运行源码和公开文件。
/*
!/.gitignore
!/README.md
!/LICENSE
!/cordis.example.yml
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/src/
!/packages/
/packages/*
!/packages/web/
/packages/web/*
!/packages/web/package.json
!/packages/web/tsconfig.client.json
!/packages/web/tsconfig.host.json
!/packages/web/src/
!/scripts/
/scripts/*
!/scripts/build-web.mjs
!/scripts/configure.mjs
!/scripts/start-web.mjs

# 运行源码目录内也排除本地环境、测试、日志和生成文件。
node_modules/
.env
.env.*
cordis.yml
cordis.local.yml
tests/
fixtures/
*.test.*
*.spec.*
*.log
