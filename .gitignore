# 默认忽略根目录新增内容，只开放运行源码和公开文件。
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/route-planning.png
!/docs/screenshots/open-trip-planner.png
!/docs/screenshots/day-itinerary.png
!/LICENSE
!/cordis.example.yml
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/src/
!/packages/
/packages/*
!/packages/web/
/packages/web/*
!/packages/web/package.json
!/packages/web/tsconfig.client.json
!/packages/web/tsconfig.host.json
!/packages/web/src/
!/scripts/
/scripts/*
!/scripts/build-web.mjs
!/scripts/pack-bundle.mjs
!/scripts/configure.mjs
!/scripts/start-web.mjs

# 运行源码目录内也排除本地环境、测试、日志和生成文件。
node_modules/
.env
.env.*
cordis.yml
cordis.local.yml
tests/
fixtures/
*.test.*
*.spec.*
*.log

# 公开可离线运行的核心用例和明确列出的模拟样本。
!/tests/
/tests/*
!/tests/core/
/tests/core/*
!/tests/core/*.test.ts
!/tests/core/storage-helper.ts
!/tests/core/data/
/tests/core/data/*
!/tests/core/data/routes.ts
!/tests/core/data/route-presentation.ts
