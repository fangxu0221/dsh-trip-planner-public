# 默认忽略根目录新增内容，只开放运行源码和公开文件。
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/route-planning.png
!/docs/screenshots/open-trip-planner.png
!/docs/screenshots/day-itinerary.png
!/LICENSE
!/cordis.example.yml
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/src/
!/packages/
/packages/*
!/packages/web/
/packages/web/*
!/packages/web/package.json
!/packages/web/tsconfig.client.json
!/packages/web/tsconfig.host.json
!/packages/web/src/
!/scripts/
/scripts/*
!/scripts/build-web.mjs
!/scripts/pack-bundle.mjs
!/scripts/configure.mjs
!/scripts/start-web.mjs

# 运行源码目录内也排除本地环境、测试、日志和生成文件。
node_modules/
.env
.env.*
cordis.yml
cordis.local.yml
tests/
fixtures/
*.test.*
*.spec.*
*.log

# 公开可离线运行的核心用例和明确列出的模拟样本。
!/tests/
/tests/*
!/tests/core/
/tests/core/*
!/tests/core/*.test.ts
!/tests/core/storage-helper.ts
!/tests/core/data/
/tests/core/data/*
!/tests/core/data/routes.ts
!/tests/core/data/route-presentation.ts


# 公开 Agent 评测源码、场景和 Fake 数据，默认忽略其余本地文件。
!/eval/
/eval/*
!/eval/README.md
!/eval/package.json
!/eval/pnpm-lock.yaml
!/eval/tsconfig.json
!/eval/runner/
/eval/runner/*
!/eval/runner/agent.ts
!/eval/runner/main.ts
!/eval/runner/offline.test.ts
!/eval/runner/report.ts
!/eval/runner/scenarios.ts
!/eval/runner/score.ts
!/eval/runner/trace.ts
!/eval/scenarios/
/eval/scenarios/*
!/eval/scenarios/agent_v1.jsonl
!/eval/fixtures/
/eval/fixtures/*
!/eval/fixtures/amap.ts
/eval/reports/
/eval/node_modules/
